.game-ui { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: #f7efd9; font-size: 20px; }
.world-input, .full-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
Label { white-space: normal; }
Button { color: #f7efd9; border-width: 1px; border-color: #55708a; border-radius: 10px; background-color: #243b54; padding: 10px 16px; -unity-text-align: middle-center; font-size: 20px; }
Button:hover { background-color: #355775; }
Button:active { background-color: #173047; }
Button:disabled { color: #91a1ad; background-color: #24313e; border-color: #3e4c57; }
.top-hud { position: absolute; left: 20px; right: 20px; top: 16px; height: 64px; flex-direction: row; align-items: center; justify-content: space-between; }
.header-copy { flex-grow: 1; }
.brand { font-size: 24px; color: #f1c975; }
.small { font-size: 14px; color: #c5d3de; }
.timer { font-size: 34px; -unity-text-align: middle-center; }
.small-button { width: 84px; height: 48px; font-size: 17px; margin-left: 8px; padding: 4px; }
.dock-frame { position: absolute; bottom: 0; background-color: #132438; border-top-left-radius: 8px; border-top-right-radius: 8px; }
.dock { position: absolute; width: 600px; height: 234px; bottom: 0; padding: 10px 16px; transform-origin: 50% 100%; background-color: #132438; border-top-width: 2px; border-top-color: #53697d; border-top-left-radius: 12px; border-top-right-radius: 12px; }
.energy-row { flex-direction: row; align-items: center; height: 28px; margin-bottom: 6px; }
.energy-label { width: 150px; color: #ebccff; }
.energy-pips { flex-direction: row; flex-grow: 1; height: 17px; }
.energy-pip { flex-grow: 1; margin-right: 4px; border-radius: 3px; background-color: #3c3454; overflow: hidden; }
.energy-pip-fill { width: 0; height: 100%; background-color: #b18aef; }
.energy-full .energy-pip-fill { background-color: #e4b3ff; }
.energy-full .energy-mode { color: #ffe39c; }
.hand-layout { flex-direction: row; align-items: center; justify-content: space-between; height: 150px; flex-shrink: 0; }
.card-row { flex-direction: row; align-items: center; width: 488px; flex-shrink: 0; }
.unit-card { width: 112px; height: 150px; flex-shrink: 0; margin-right: 10px; padding: 0; overflow: hidden; background-color: #183149; border-width: 3px; border-color: #b5c6d5; border-radius: 10px; font-size: 17px; }
.card-art { position: absolute; top: 0; bottom: 0; left: 0; right: 0; -unity-background-scale-mode: scale-and-crop; }
.card-name { position: absolute; left: 0; right: 0; bottom: 0; height: 28px; padding-bottom: 1px; font-size: 19px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgba(7,18,32,0.86); color: #fff3d2; }
.card-cost { position: absolute; top: 3px; left: 3px; width: 29px; height: 31px; border-radius: 16px; border-width: 2px; border-color: #ecc6ff; background-color: #973cc6; color: white; font-size: 23px; -unity-font-style: bold; -unity-text-align: middle-center; }
.next-card { width: 64px; flex-shrink: 0; align-items: center; }
.next-card-art { width: 60px; height: 80px; -unity-background-scale-mode: scale-and-crop; border-radius: 7px; border-width: 2px; border-color: #6f859b; opacity: 0.85; }
.next-card-label { font-size: 13px; color: #b7c9d7; -unity-text-align: middle-center; }
.energy-mode { color: #d9b1ff; font-size: 15px; margin-left: 8px; }
.unit-card.selected { border-color: #f5d17a; background-color: #36688f; }
.unit-card.unaffordable { color: #9caab8; background-color: #253d50; }
.unit-card.unaffordable .card-art { opacity: 0.5; }
.unit-card.dragging { opacity: 0; }
.drag-card { display: none; position: absolute; left: 0; top: 0; width: 112px; height: 150px; transform-origin: 0 0; overflow: hidden; opacity: 0.68; border-width: 3px; border-color: #f5d17a; border-radius: 10px; background-color: #183149; }
.drag-card.invalid { border-color: #f08270; }
.unit-card.b3-card, .drag-card.b3-card { border-width: 0; border-radius: 12px; background-color: #14223b; }
.b3-card .card-art { left: 5px; right: 5px; top: 5px; bottom: 5px; border-radius: 9px; }
.b3-card-frame { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-image: url("B3/UI/CardFrame.png"); -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 48; -unity-slice-bottom: 48; -unity-slice-scale: 0.35px; }
.b3-small-frame { -unity-slice-scale: 0.18px; }
.b3-card .card-name { left: 7px; right: 7px; bottom: 7px; height: 25px; border-radius: 4px; background-color: rgba(12,28,55,0.94); color: #fff1be; }
.b3-card .card-cost { left: 5px; top: 5px; width: 29px; height: 29px; background-color: #194fb5; border-color: #f7d064; color: #fff6d0; }
.unit-card.b3-card.selected { border-width: 2px; border-color: #fff4ab; }
.b3-card.unaffordable .b3-card-frame { -unity-background-image-tint-color: #929aa7; }
.drag-card.b3-card.invalid .b3-card-frame { -unity-background-image-tint-color: #f08270; }
.next-card-art.b3-next { border-width: 0; border-radius: 8px; }
.keep-status { position: absolute; top: 8px; left: 0; width: 84px; font-size: 10px; color: #f5d17a; -unity-text-align: middle-center; background-color: rgba(9,19,31,0.8); }
.hint { color: #b7c9d7; font-size: 17px; margin-top: 6px; }
.notice { height: 22px; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 14px; color: #e8cd8c; margin-top: 6px; }
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(9, 19, 31, 0.87); }
.waiting-overlay { background-color: rgba(9, 19, 31, 0.62); }
.lobby-panel { width: 88%; max-width: 500px; padding: 22px; background-color: #fff2d8; border-radius: 18px; border-width: 3px; border-color: #b18f64; color: #26314a; }
.title { font-size: 44px; color: #25324b; -unity-text-align: middle-center; -unity-font-style: bold; }
.subtitle { font-size: 20px; color: #4f4a45; -unity-text-align: middle-center; margin-top: 12px; margin-bottom: 16px; }
TextField { margin: 8px 0; font-size: 19px; flex-direction: column; }
.unity-base-field__label { color: #cad8e4; margin-bottom: 6px; }
.unity-base-text-field__input { color: #f7efd9; background-color: #0c1e2e; border-width: 1px; border-color: #49647c; border-radius: 7px; padding: 10px; min-height: 42px; }
.primary-button { min-height: 56px; margin-top: 12px; background-color: #ffc948; border-color: #754719; color: #2c2938; -unity-font-style: bold; }
.primary-button:hover { background-color: #ffdb73; }
.secondary-button { min-height: 48px; margin-top: 12px; }
.waiting-actions { flex-direction: row; }
.waiting-actions > Button { flex-grow: 1; flex-basis: 0; }
.waiting-leave { min-height: 56px; margin-top: 16px; margin-left: 12px; }
.lobby-panel .hint { color: #5c5146; }
.section-title { font-size: 27px; -unity-text-align: middle-center; -unity-font-style: bold; }
.invite-code { font-size: 44px; color: #225786; margin-top: 8px; -unity-text-align: middle-center; }
.players { font-size: 21px; white-space: normal; margin-top: 24px; margin-bottom: 12px; }
.health-bar { position: absolute; width: 84px; height: 6px; transform-origin: 0 0; background-color: #0d1e2d; border-width: 1px; border-color: #1d3040; border-radius: 2px; }
.health-fill { height: 100%; background-color: #69bcf0; border-radius: 2px; }
.health-bar.enemy .health-fill { background-color: #f08270; }
.health-amount { position: absolute; left: -4px; right: -4px; top: -12px; height: 18px; font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; color: white; -unity-text-outline-color: #0d1e2d; -unity-text-outline-width: 1px; white-space: nowrap; }
.health-bar.unit-health { width: 32px; height: 4px; border-width: 0; }
.unit-health .health-amount { top: -17px; height: 16px; font-size: 13px; }
.unit-status { position: absolute; top: -30px; left: -29px; width: 90px; font-size: 10px; color: #b4edff; -unity-text-align: middle-center; }

.menu-overlay {
    --menu-ink: #26334e;
    --menu-cream: #fff2d8;
    --menu-stone: #e9cda6;
    --menu-edge: #a98458;
    --menu-amber: #ffc744;
    --menu-deep-gold: #9d591b;
    --menu-blue: #245382;
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: #e8cda7;
    color: var(--menu-ink);
}
.menu-shell {
    position: absolute;
    transform-origin: 0 0;
    overflow: hidden;
    background-color: var(--menu-cream);
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: var(--menu-edge);
}
.menu-page { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.menu-body { padding: 14px 12px 14px; }
.menu-title {
    font-size: 37px;
    min-height: 62px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: #f5deb5;
    border-radius: 15px;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: var(--menu-edge);
    margin-bottom: 12px;
}
.menu-hero {
    position: relative;
    height: 324px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 15px;
    border-width: 2px;
    border-color: var(--menu-edge);
    background-color: #dae4a3;
    margin-bottom: 12px;
}
.menu-hero-art {
    position: absolute;
    left: 50%;
    top: 0;
    width: 648px;
    height: 324px;
    translate: -50% 0;
    background-image: url("DuelMenuBattlefield.jpg");
    background-size: 100% 100%;
}
.menu-button {
    min-height: 50px;
    flex-shrink: 0;
    background-color: #ffe8bc;
    border-color: var(--menu-edge);
    border-width: 2px;
    border-bottom-width: 4px;
    border-radius: 12px;
    color: var(--menu-ink);
    -unity-font-style: bold;
    font-size: 23px;
    padding: 5px 10px;
}
.menu-button:hover { background-color: #fff2d6; }
.menu-button:focus { border-color: var(--menu-blue); }
.menu-button:active { background-color: #eec98f; }
.menu-button:disabled { opacity: 0.64; }
.menu-primary {
    min-height: 82px;
    font-size: 35px;
    border-bottom-width: 7px;
    border-radius: 18px;
    background-color: var(--menu-amber);
    border-color: var(--menu-deep-gold);
}
.menu-primary:hover { background-color: #ffda72; }
.menu-primary:active { background-color: #edaa2e; }
.menu-status { font-size: 19px; color: var(--menu-blue); -unity-text-align: middle-center; white-space: normal; margin: 3px 0; }
.menu-panel { padding: 10px 12px 12px; border-radius: 14px; border-width: 2px; border-color: var(--menu-edge); background-color: #f5e2c3; }
.menu-heading { font-size: 23px; -unity-font-style: bold; }
.menu-field { margin: 4px 0; min-width: 0; }
.menu-name-field { margin-bottom: 9px; }
.menu-field .unity-base-field__label { color: #504237; margin-bottom: 3px; font-size: 18px; }
.menu-field .unity-base-text-field__input { background-color: #fffbec; border-color: var(--menu-edge); color: var(--menu-ink); min-height: 40px; }
.menu-room-row { flex-direction: row; align-items: flex-end; }
.menu-code { flex-grow: 1; flex-basis: 0; }
.menu-join { margin-left: 8px; margin-bottom: 4px; color: #fff2d8; background-color: var(--menu-blue); border-color: #173a61; }
.menu-join:hover { background-color: #336b9d; }
.menu-join:active { background-color: #193f68; }
.menu-friend-button { margin-top: 5px; }
.menu-tabs {
    flex-direction: row;
    flex-shrink: 0;
    height: 84px;
    padding: 9px 10px;
    background-color: var(--menu-stone);
    border-top-width: 3px;
    border-color: var(--menu-edge);
}
.menu-tab { flex-grow: 1; flex-basis: 0; margin: 0 4px; font-size: 26px; }
.menu-tab-selected { background-color: var(--menu-amber); border-color: var(--menu-deep-gold); }
.menu-tab-selected:hover { background-color: #ffda72; }
.menu-deck-header { flex-direction: row; justify-content: space-between; align-items: center; }
.menu-deck-count {
    font-size: 20px;
    color: #fff2d8;
    background-color: var(--menu-blue);
    -unity-text-align: middle-center;
    border-radius: 12px;
    padding: 4px 10px;
}
.menu-reserve-heading { margin-top: 7px; }
.menu-card-row { flex-direction: row; margin: 4px -3px 0; }
.menu-card {
    position: relative;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    max-width: 154px;
    height: 128px;
    padding: 0;
    margin: 0 3px;
    border-radius: 11px;
    border-width: 3px;
    border-color: #b77822;
    background-color: #223e69;
    overflow: hidden;
}
.menu-card:hover, .menu-card:focus { border-color: #ffce4a; }
.menu-card-selected, .menu-card-selected:hover, .menu-card-selected:focus { border-color: #3ba7e1; }
.menu-card-art { position: absolute; top: 0; bottom: 0; left: 0; right: 0; -unity-background-scale-mode: scale-and-crop; }
.menu-card-name {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 23px;
    font-size: 16px;
    background-color: rgba(17,34,61,0.92);
    color: #fff3da;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.menu-card-cost, .menu-card-in-deck {
    position: absolute;
    top: 3px;
    color: #fff6dc;
    -unity-text-align: middle-center;
    border-radius: 9px;
    -unity-font-style: bold;
}
.menu-card-cost { left: 3px; width: 24px; height: 26px; background-color: #24568a; font-size: 19px; }
.menu-card-in-deck { right: 3px; padding: 3px; background-color: #275f46; font-size: 13px; }
.menu-reset { align-self: center; min-height: 40px; font-size: 19px; margin-top: 8px; }
.menu-details { min-height: 46px; font-size: 18px; color: #574a3c; margin: 10px 4px; white-space: normal; }
.menu-catalog-title { min-height: 42px; font-size: 26px; margin-bottom: 5px; }
.menu-catalog { padding: 5px 4px 12px; }


/* Cartoon fantasy skin v1.
 * All interactive controls keep their existing names, layout and event wiring.
 * Background art is generated by DuelCartoonSkin at runtime; nine-slicing keeps
 * the black outlines and scroll caps crisp on small and wide screens.
 */
.game-ui { color: #fff7e4; }
Button {
    background-color: #e9c292;
    border-width: 3px; border-color: #15131d; border-radius: 12px;
    color: #241b1e;
    -unity-font-style: bold;
    -unity-text-outline-color: rgba(255,238,187,0.40);
    -unity-text-outline-width: 0.4px;
}
Button:hover { -unity-background-image-tint-color: #fff1c2; }
Button:active { -unity-background-image-tint-color: #d4c1ad; }
Button:disabled { opacity: 0.63; }
.menu-shell, .menu-title, .menu-panel, .menu-button, .menu-card,
.lobby-panel, .top-hud, .dock, .unit-card, .drag-card,
.b3-card-frame, .primary-button, .secondary-button, .small-button,
.menu-deck-count {
    -unity-slice-left: 27; -unity-slice-right: 27;
    -unity-slice-top: 25; -unity-slice-bottom: 25;
    -unity-slice-scale: 0.65px;
    -unity-background-scale-mode: stretch-to-fill;
}
.menu-overlay { background-color: #202a48; color: #2f2524; }
.menu-shell {
    background-color: #f6d6a6;
    border-width: 4px;
    border-color: #17151d;
    border-radius: 19px;
}
.menu-body { padding: 19px 19px 15px; }
.menu-title {
    min-height: 74px;
    padding: 10px 16px;
    border-width: 0; border-radius: 15px;
    background-color: transparent;
    color: #3c231e;
    font-size: 37px;
    -unity-text-outline-color: rgba(255,247,204,0.7);
    -unity-text-outline-width: 1px;
}
.menu-hero {
    border-width: 5px;
    border-color: #211822;
    border-radius: 16px;
    background-color: #7bc7df;
    margin-bottom: 15px;
}
.menu-button {
    border-width: 0; border-radius: 13px;
    background-color: transparent;
    color: #35241d;
    font-size: 23px;
    padding: 8px 15px;
}
.menu-button:hover { -unity-background-image-tint-color: #fff8d7; }
.menu-button:active { -unity-background-image-tint-color: #d4c6aa; }
.menu-button:focus { border-color: transparent; }
.menu-primary {
    min-height: 82px;
    font-size: 35px;
    color: #fff9df;
    border-width: 0;
    -unity-text-outline-color: #21201b;
    -unity-text-outline-width: 2px;
}
.menu-primary:hover { -unity-background-image-tint-color: #edffb7; }
.menu-primary:active { -unity-background-image-tint-color: #bdd79b; }
.menu-join {
    color: #fff8e5;
    background-color: transparent;
    border-width: 0;
    -unity-text-outline-color: #1a3053;
    -unity-text-outline-width: 1px;
}
.menu-join:hover { -unity-background-image-tint-color: #d0f5ff; }
.menu-join:active { -unity-background-image-tint-color: #92b4de; }
.menu-panel {
    background-color: transparent;
    border-width: 0;
    border-radius: 16px;
    padding: 20px 22px 23px;
}
.menu-heading { color: #432c23; }
.menu-status { color: #315783; font-size: 18px; }
.menu-tabs {
    height: 89px;
    padding: 7px 10px 11px;
    border-top-width: 5px;
    border-color: #17151e;
    background-color: #34364a;
}
.menu-tab {
    margin: 1px 5px;
    color: #302523;
    font-size: 25px;
}
.menu-tab-selected, .menu-tab-selected:hover {
    color: #fff7d9;
    -unity-text-outline-color: #1b2116;
    -unity-text-outline-width: 1px;
}
.menu-deck-count {
    border-radius: 8px;
    background-color: transparent;
    padding: 6px 13px;
    color: #fff7de;
}
.menu-field .unity-base-field__label { color: #533728; font-size: 19px; }
.menu-field .unity-base-text-field__input {
    border-width: 3px;
    border-color: #221b20;
    border-radius: 9px;
    color: #31231f;
    background-color: #fff3d4;
    min-height: 44px;
    -unity-text-outline-width: 0px;
}
.menu-card {
    border-width: 0;
    border-radius: 14px;
    background-color: transparent;
    overflow: hidden;
}
.menu-card-art { top: 7px; bottom: 24px; left: 7px; right: 7px; }
.menu-card:hover { -unity-background-image-tint-color: #fff2c2; }
.menu-card-selected, .menu-card-selected:hover {
    -unity-background-image-tint-color: #c1f5fb;
}
.menu-card-name {
    background-color: rgba(23,24,39,.93);
    color: #fff1bd;
    font-size: 16px;
    left: 7px; right: 7px;
    bottom: 7px; height: 25px;
    -unity-text-outline-color: #191519;
    -unity-text-outline-width: 1px;
}
.menu-card-cost {
    border-width: 0;
    background-color: transparent;
    border-radius: 0;
    width: 29px; height: 29px;
    top: 0; left: 0;
    color: #fff7e6;
    font-size: 18px;
    -unity-text-outline-color: #25112a;
    -unity-text-outline-width: 1px;
}
.menu-card-in-deck {
    border-width: 2px;
    border-color: #151c18;
    background-color: #2d9c68;
    color: #fff8dc;
}
.menu-details { color: #524030; font-size: 18px; }
.menu-catalog-title { min-height: 53px; font-size: 25px; }
.menu-reset { min-height: 48px; }
.top-hud {
    height: 73px;
    padding: 9px 17px;
    border-width: 0;
    border-radius: 14px;
    background-color: transparent;
}
.brand {
    color: #ffe49a;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-outline-color: #211a25;
    -unity-text-outline-width: 1px;
}
.small { color: #e8e5da; font-size: 14px; }
.timer {
    color: #fffaf0;
    font-size: 33px;
    -unity-font-style: bold;
    -unity-text-outline-color: #121a26;
    -unity-text-outline-width: 1px;
}
.small-button {
    margin-left: 7px;
    width: 80px; height: 51px;
    padding: 5px;
    border-width: 0;
    background-color: transparent;
    color: #37241d;
    font-size: 17px;
}
.dock-frame {
    background-color: rgba(15,20,38,0.75);
    border-top-width: 4px;
    border-top-color: #17151d;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
}
.dock {
    padding: 13px 18px 11px;
    border-width: 0;
    border-radius: 16px;
    background-color: transparent;
}
.energy-row { height: 30px; margin-bottom: 7px; }
.energy-label { color: #ffe3be; -unity-font-style: bold; }
.energy-mode { color: #eac3ff; }
.energy-pips { height: 19px; }
.energy-pip {
    margin-right: 4px;
    border-width: 2px;
    border-color: #13121b;
    background-color: #40354b;
    border-radius: 6px;
}
.energy-pip-fill { background-color: #cb57df; }
.energy-full .energy-pip-fill { background-color: #ffbdff; }
.unit-card, .drag-card {
    background-color: transparent;
    border-width: 0;
    border-radius: 14px;
}
.unit-card .card-art { left: 6px; right: 6px; top: 6px; bottom: 6px; }
.unit-card.selected { -unity-background-image-tint-color: #ffed98; }
.unit-card.unaffordable { -unity-background-image-tint-color: #87818b; }
.drag-card.invalid { -unity-background-image-tint-color: #f0918c; }
.b3-card-frame {
    /* Border-only overlay. An opaque center would hide ALL B3 card portraits. */
    background-color: transparent;
    background-image: none;
    border-width: 2px;
    border-color: #e8b261;
    border-radius: 12px;
    -unity-background-image-tint-color: #ffffff;
    -unity-slice-scale: 0.65px;
}
.b3-small-frame { -unity-slice-scale: 0.35px; }
.unit-card.b3-card, .drag-card.b3-card {
    background-color: transparent;
    border-width: 0;
}
.b3-card .card-art { top: 7px; left: 7px; right: 7px; bottom: 7px; }
.b3-card .card-name {
    bottom: 7px; left: 7px; right: 7px;
    background-color: rgba(18,23,40,.91);
}
.b3-card .card-cost {
    left: 2px; top: 2px;
    background-color: transparent;
    border-width: 0;
    color: #fff5dc;
}
.b3-card.unaffordable .b3-card-frame {
    -unity-background-image-tint-color: #898b9c;
}
.card-name {
    color: #fff3ca;
    background-color: rgba(19,20,35,0.90);
    -unity-text-outline-color: #15131a;
    -unity-text-outline-width: 1px;
}
.card-cost {
    background-color: transparent;
    border-width: 0; border-radius: 0;
    width: 35px; height: 35px;
    left: 1px; top: 1px;
    color: #fff9ec;
    font-size: 24px;
    -unity-text-outline-color: #251029;
    -unity-text-outline-width: 1px;
}
.next-card-art {
    border-width: 3px;
    border-color: #ecac4d;
    background-color: #222941;
}
.next-card-label { color: #ffe8ae; }
.notice { color: #ffe6b3; }
.keep-status { color: #fff0b0; background-color: #25233c; }
.overlay { background-color: rgba(11,16,29,0.82); }
.waiting-overlay { background-color: rgba(11,16,29,0.72); }
.lobby-panel {
    max-width: 515px;
    padding: 29px;
    border-width: 0;
    border-radius: 18px;
    background-color: transparent;
    color: #39281f;
}
.title, .section-title { color: #41261f; -unity-font-style: bold; }
.title { font-size: 43px; }
.subtitle { color: #5c4030; }
.invite-code { color: #275e9f; -unity-font-style: bold; }
.players { color: #352822; }
.lobby-panel .hint { color: #684a37; }
.primary-button, .secondary-button {
    border-width: 0;
    border-radius: 13px;
    background-color: transparent;
    color: #392a22;
}
.primary-button {
    min-height: 58px;
    color: #fff9dc;
    -unity-text-outline-color: #2b271b;
    -unity-text-outline-width: 1px;
}
.secondary-button { min-height: 52px; }
.health-bar {
    background-color: #171b2a;
    border-width: 2px;
    border-color: #11131b;
    border-radius: 4px;
}
.health-fill { background-color: #31bde7; }
.health-bar.enemy .health-fill { background-color: #f35758; }
.health-amount {
    color: #fff7e4;
    -unity-text-outline-color: #11141d;
    -unity-text-outline-width: 2px;
}
.unit-health { border-width: 1px; }
