/* Modern B3 UI — native UI Toolkit surfaces; existing B3 illustrations unchanged. */
.game-ui { position:absolute; left:0; right:0; top:0; bottom:0; color:#f9fafc; font-size:20px; }
.world-input, .full-layer { position:absolute; left:0; right:0; top:0; bottom:0; }
Button { background-color:#fbfaf7; color:#213654; border-width:1px; border-color:#aab5c5; border-radius:10px; padding:8px 12px; font-size:20px; -unity-font-style:bold; -unity-text-align:middle-center; -unity-text-outline-width:0px; }
Button:hover { background-color:#edf2fa; }
Button:active { background-color:#dce5f3; }
Button:focus { border-color:#2561c7; }
Button:disabled { opacity:.6; }
.menu-overlay { position:absolute; left:0; right:0; top:0; bottom:0; background-color:#e9edf3; color:#203653; }
.menu-shell { position:absolute; transform-origin:0 0; overflow:hidden; background-color:#faf8f4; }
.menu-page { flex-grow:1; flex-shrink:1; min-height:0; }
.menu-body { padding:20px 20px 16px; }
.menu-title-row { flex-direction:row; align-items:center; justify-content:space-between; margin-bottom:10px; }
.menu-title { font-size:36px; color:#203653; -unity-font-style:bold; min-height:54px; -unity-text-align:middle-left; flex-shrink:0; }
.menu-subtitle { font-size:20px; color:#65748b; margin-bottom:16px; -unity-font-style:bold; }
.settings-button { width:52px; height:52px; border-width:0; border-radius:10px; padding:7px; background-color:transparent; }
.menu-hero { position:relative; height:324px; flex-shrink:0; overflow:hidden; border-radius:16px; background-color:#dce9bb; margin-bottom:20px; }
.menu-hero-art { position:absolute; left:50%; top:0; width:648px; height:324px; translate:-50% 0; background-image:url("DuelMenuBattlefield.jpg"); background-size:100% 100%; }
.menu-button { min-height:52px; flex-shrink:0; background-color:transparent; border-color:#8292aa; border-width:1px; border-radius:12px; color:#203653; font-size:22px; padding:8px 12px; }
.menu-primary, .primary-button { min-height:74px; font-size:32px; background-color:#ffc92e; border-width:0; border-radius:14px; color:#203653; }
.menu-primary:hover, .primary-button:hover { background-color:#ffdb64; }
.menu-primary:active, .primary-button:active { background-color:#eab116; }
.menu-primary:disabled, .primary-button:disabled { background-color:#e6e8eb; color:#8791a0; }
.menu-status { font-size:18px; color:#536b8c; white-space:normal; -unity-text-align:middle-center; margin-top:8px; margin-bottom:8px; }
.menu-panel { padding:12px 0; background-color:transparent; border-width:0; }
.menu-heading { font-size:23px; color:#203653; -unity-font-style:bold; margin-bottom:8px; }
.menu-field { margin:6px 0; min-width:0; flex-direction:column; font-size:19px; }
.menu-field .unity-base-field__label { color:#64748b; font-size:18px; margin-bottom:4px; }
.menu-field .unity-base-text-field__input { color:#203653; background-color:#ffffff; border-color:#c1c9d4; border-width:1px; border-radius:8px; min-height:44px; padding:8px; }
.menu-room-row { flex-direction:row; align-items:center; }
.menu-room-row > Button { flex-grow:1; flex-basis:0; min-width:0; }
.menu-friend-button { margin-right:5px; }
.menu-join { margin-left:5px; }
.menu-code { margin-top:8px; }
.menu-settings-panel { margin-top:10px; padding:14px; border-width:1px; border-color:#d8dfe8; border-radius:12px; background-color:#ffffff; }
.menu-tabs { flex-direction:row; flex-shrink:0; height:86px; padding:4px 12px 6px; border-top-width:1px; border-top-color:#d4dbe5; background-color:#faf8f4; }
.menu-tab { flex-grow:1; flex-basis:0; margin:0 5px; border-width:0; border-bottom-width:3px; border-bottom-color:transparent; background-color:transparent; color:#68778e; font-size:20px; align-items:center; justify-content:center; padding:4px; }
.menu-tab-selected, .menu-tab-selected:hover { color:#175ccc; border-bottom-color:#175ccc; background-color:transparent; }
.menu-tab:hover { background-color:#edf2fa; }
.menu-icon { width:34px; height:34px; flex-shrink:0; -unity-background-scale-mode:scale-to-fit; -unity-background-image-tint-color:#68778e; }
.menu-tab-selected .menu-icon { -unity-background-image-tint-color:#175ccc; }
.menu-tab .icon-label { font-size:20px; -unity-font-style:bold; -unity-text-align:middle-center; }
.menu-deck-count { font-size:20px; color:#2457a6; background-color:#e0eafa; -unity-font-style:bold; -unity-text-align:middle-center; border-radius:10px; padding:6px 12px; }
.deck-panel { padding:0; }
.deck-cards { flex-direction:column; }
.menu-card-row { flex-direction:row; margin-top:6px; margin-bottom:6px; }
.menu-card { position:relative; flex-grow:1; flex-basis:0; min-width:0; max-width:154px; height:128px; padding:0; margin:0 4px; border-width:1px; border-color:#c5ced9; border-radius:10px; background-color:#304e68; overflow:hidden; }
.menu-card-art { position:absolute; top:0; bottom:0; left:0; right:0; -unity-background-scale-mode:scale-and-crop; }
.menu-card:hover, .menu-card:focus { border-color:#2671db; }
.menu-card-selected, .menu-card-selected:hover, .menu-card-selected:focus { border-width:3px; border-color:#2671db; }
.menu-card-name { position:absolute; left:0; right:0; bottom:0; height:23px; font-size:16px; color:#fff; background-color:rgba(18,34,54,.80); -unity-font-style:bold; -unity-text-align:middle-center; }
.menu-card-cost, .menu-card-in-deck { position:absolute; top:3px; color:white; -unity-text-align:middle-center; -unity-font-style:bold; }
.menu-card-cost { left:3px; width:28px; height:28px; background-color:#175ccc; border-width:1px; border-color:#fff; border-radius:14px; font-size:20px; }
.menu-card-in-deck { right:3px; padding:3px 5px; border-radius:6px; background-color:#31855c; font-size:13px; }
.deck-footer { flex-direction:row; align-items:center; justify-content:space-between; margin-top:6px; }
.deck-guide { font-size:16px; color:#68778e; white-space:normal; flex-shrink:1; }
.menu-reset { min-height:36px; font-size:16px; padding:4px 10px; }
.menu-details { min-height:42px; color:#526780; white-space:normal; font-size:18px; margin:12px 2px; }
.menu-catalog-title { font-size:26px; min-height:48px; border-top-width:1px; border-top-color:#d4dbe5; padding-top:12px; margin-bottom:4px; }
.menu-catalog { padding-bottom:12px; }
.top-hud { position:absolute; left:8px; right:8px; top:7px; height:44px; background-color:transparent; overflow:visible; }
.top-hud .timer { position:absolute; top:0; left:0; width:100px; height:44px; transform-origin:0 0; color:white; font-size:23px; -unity-font-style:bold; -unity-text-align:middle-center; background-color:rgba(24,42,61,.83); border-radius:12px; }
.hud-actions { position:absolute; top:0; right:0; width:44px; height:44px; transform-origin:100% 0; overflow:visible; }
.hud-menu-button { width:44px; height:44px; margin:0; padding:7px; background-color:rgba(24,42,61,.83); color:white; border-width:0; border-radius:11px; font-size:22px; }
.hud-menu-button:hover, .hud-menu-button:active { background-color:rgba(24,42,61,.96); }
.hud-menu-button .menu-icon { width:30px; height:30px; -unity-background-image-tint-color:#ffffff; }
.hud-menu-panel { display:none; position:absolute; top:50px; right:0; width:208px; padding:10px; background-color:#faf8f4; border-radius:12px; border-width:1px; border-color:#c5ced9; }
.small { color:#526780; font-size:13px; white-space:normal; margin-bottom:6px; }
.small-button { height:42px; margin:3px 0; font-size:16px; background-color:#ffffff; }
.danger-button { color:#bc3a42; border-color:#dfb2b5; }
.dock-frame { position:absolute; bottom:0; background-color:transparent; }
.dock { position:absolute; width:600px; height:220px; bottom:0; padding:7px 16px; transform-origin:50% 100%; border-radius:14px; background-color:rgba(21,39,55,.84); }
.hand-layout { flex-direction:row; align-items:center; justify-content:space-between; height:150px; flex-shrink:0; }
.card-row { flex-direction:row; align-items:center; width:488px; flex-shrink:0; }
.unit-card, .drag-card { width:112px; height:150px; flex-shrink:0; margin-right:10px; padding:0; overflow:hidden; background-color:#29465e; border-width:1px; border-color:#d8e1ec; border-radius:9px; }
.card-art { position:absolute; top:0; bottom:0; left:0; right:0; -unity-background-scale-mode:scale-and-crop; }
.card-name { position:absolute; bottom:0; left:0; right:0; height:25px; font-size:17px; color:#fff; background-color:rgba(19,34,52,.82); -unity-font-style:bold; -unity-text-align:middle-center; }
.card-cost { position:absolute; top:3px; left:3px; width:31px; height:31px; border-width:1px; border-color:#fff; border-radius:16px; background-color:#175ccc; color:#fff; font-size:22px; -unity-font-style:bold; -unity-text-align:middle-center; }
.unit-card.selected, .unit-card.selected:hover { border-width:3px; border-color:#ffdc52; }
.unit-card.unaffordable .card-art { opacity:.48; }
.unit-card.dragging { opacity:0; }
.drag-card { display:none; position:absolute; left:0; top:0; transform-origin:0 0; opacity:.68; margin:0; border-width:3px; border-color:#ffdc52; }
.drag-card.invalid { border-color:#ef6868; }
.b3-card-frame { position:absolute; top:0; left:0; bottom:0; right:0; background-color:transparent; background-image:none; border-width:0; }
.next-card { width:64px; flex-shrink:0; align-items:center; }
.next-card-art { width:60px; height:80px; -unity-background-scale-mode:scale-and-crop; border-radius:7px; border-width:1px; border-color:#b7c9db; overflow:hidden; }
.next-card-label { font-size:15px; color:#fff; -unity-font-style:bold; -unity-text-align:middle-center; margin-bottom:5px; }
.notice { height:22px; flex-shrink:0; font-size:15px; color:#f5f7fb; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; -unity-text-align:middle-center; }
.energy-row { flex-direction:row; align-items:center; height:29px; margin-top:6px; flex-shrink:0; }
.energy-label { width:56px; color:#fff; font-size:24px; -unity-font-style:bold; }
.energy-pips { flex-direction:row; flex-grow:1; height:15px; }
.energy-pip { flex-grow:1; margin-right:4px; border-radius:4px; background-color:rgba(229,231,244,.27); overflow:hidden; }
.energy-pip-fill { width:0; height:100%; background-color:#cda9f4; }
.energy-full .energy-pip-fill { background-color:#ead5ff; }
.energy-mode { display:none; width:36px; color:#ecd8ff; font-size:16px; -unity-font-style:bold; -unity-text-align:middle-center; }
.overlay { position:absolute; left:0; right:0; top:0; bottom:0; justify-content:center; align-items:center; background-color:rgba(19,33,48,.67); }
.lobby-panel { width:88%; max-width:500px; padding:24px; border-radius:16px; border-width:1px; border-color:#d7dfe8; background-color:#faf8f4; color:#203653; }
.title, .section-title { color:#203653; -unity-text-align:middle-center; -unity-font-style:bold; }
.title { font-size:44px; }
.section-title { font-size:27px; }
.subtitle { color:#64748b; font-size:20px; -unity-text-align:middle-center; margin:12px 0 16px; white-space:normal; }
.primary-button { min-height:56px; font-size:23px; margin-top:12px; }
.secondary-button { min-height:48px; margin-top:12px; font-size:21px; background-color:transparent; }
.waiting-actions { flex-direction:row; align-items:center; }
.waiting-actions > Button { flex-grow:1; flex-basis:0; min-width:0; }
.waiting-leave { min-height:56px; margin-top:12px; margin-left:8px; font-size:18px; }
.invite-code { font-size:44px; color:#175ccc; margin-top:8px; -unity-font-style:bold; -unity-text-align:middle-center; }
.players { font-size:21px; color:#203653; white-space:normal; margin:20px 0 10px; }
.hint { color:#64748b; font-size:17px; margin-top:12px; white-space:normal; }
.health-bar { position:absolute; width:84px; height:6px; transform-origin:0 0; border-width:1px; border-color:#24374b; background-color:rgba(26,39,52,.88); border-radius:3px; }
.health-fill { height:100%; background-color:#48a4ed; border-radius:2px; }
.health-bar.enemy .health-fill { background-color:#ed6664; }
.health-amount { position:absolute; left:-4px; right:-4px; top:-16px; height:18px; font-size:13px; color:white; -unity-font-style:bold; -unity-text-align:middle-center; -unity-text-outline-color:#182536; -unity-text-outline-width:1px; white-space:nowrap; }
.health-bar.unit-health { width:32px; height:4px; border-width:0; }
.keep-status { position:absolute; top:8px; left:0; width:84px; font-size:10px; color:#fff; -unity-text-align:middle-center; background-color:rgba(25,40,57,.77); }
.unit-status { position:absolute; top:-14px; left:-29px; width:90px; font-size:10px; color:#cceaff; -unity-text-outline-color:#182536; -unity-text-outline-width:1px; -unity-text-align:middle-center; }

/* Approved Modern B3 composition: full-height home artwork, compact 4-column
   card grids, and modal secondary controls. No parent may shrink card rows. */
.menu-body { flex-shrink:0; }
.menu-page .unity-scroll-view__content-container { flex-shrink:0; }
.menu-shell { background-color:#faf8f4; }
.home-body { padding:32px 16px 12px; }
.home-header { padding:0 16px; flex-shrink:0; }
.home-header .menu-title-row { margin-bottom:0; min-height:64px; }
.home-title { font-size:48px; min-height:64px; }
.home-title-accent { width:50px; height:5px; border-radius:3px; background-color:#175ccc; margin-top:2px; }
.home-header .menu-subtitle { margin-top:9px; margin-bottom:20px; font-size:22px; min-height:32px; }
.settings-button { width:50px; height:50px; align-items:center; justify-content:center; }
.settings-button .menu-icon { width:42px; height:42px; }
.menu-hero { height:470px; border-radius:18px; margin-bottom:24px; flex-shrink:0; }
.menu-hero-art { left:0; right:0; top:0; bottom:0; width:auto; height:auto; translate:0 0; background-size:cover; -unity-background-scale-mode:scale-and-crop; }
.home-body .menu-primary { height:80px; min-height:80px; font-size:35px; margin:0 8px; border-radius:17px; }
.home-body .menu-room-row { height:68px; flex-shrink:0; margin:20px 8px 0; }
.menu-room-row > Button { height:68px; min-height:68px; border-width:2px; border-radius:15px; font-size:22px; flex-direction:row; justify-content:center; align-items:center; }
.menu-room-row .menu-icon { width:32px; height:32px; margin-right:9px; }
.menu-room-row .icon-label { font-size:22px; -unity-font-style:normal; }
.menu-friend-button { margin-right:9px; }
.menu-join { margin-left:9px; }
.menu-status { margin:9px 8px 0; flex-shrink:0; }
.menu-tabs { height:100px; padding:8px 16px 5px; border-top-color:#c9d0da; }
.menu-tab { height:86px; border-radius:0; border-bottom-width:4px; margin:0 5px; }
.menu-tab .menu-icon { width:42px; height:42px; }
.menu-tab .icon-label { font-size:23px; }
.menu-tab-selected { border-bottom-color:#175ccc; }
.deck-body { padding:22px 20px 16px; }
.deck-title-row { border-bottom-width:1px; border-bottom-color:#cbd3df; padding-bottom:9px; margin-bottom:12px; flex-shrink:0; }
.deck-title-row .menu-title { font-size:32px; min-height:45px; }
.menu-deck-count { font-size:23px; background-color:#dce8fa; padding:5px 12px; border-radius:11px; }
.deck-panel, .deck-cards, .menu-catalog, .menu-card-row, .deck-footer, .catalog-header { flex-shrink:0; }
.menu-card-row { align-items:flex-start; justify-content:flex-start; flex-grow:0; flex-shrink:0; margin:5px 0; }
.menu-card { flex-grow:0; flex-shrink:0; flex-basis:auto; margin:0 4px; border-width:1px; border-radius:10px; padding:0; }
.menu-card-name, .unit-card .card-name { display:none; }
.menu-card-cost { width:33px; height:33px; border-radius:17px; font-size:23px; border-width:2px; top:2px; left:2px; }
.menu-card-in-deck { font-size:12px; }
.deck-footer { margin:6px 4px 10px; }
.deck-guide { font-size:15px; -unity-font-style:normal; color:#64748b; }
.menu-reset { font-size:15px; -unity-font-style:normal; min-height:34px; border-width:0; color:#175ccc; }
.menu-details { flex-shrink:0; background-color:#edf2fa; border-radius:8px; padding:9px 12px; margin:6px 4px 10px; font-size:17px; }
.catalog-header { flex-direction:row; align-items:center; justify-content:space-between; border-top-width:1px; border-top-color:#cbd3df; padding-top:15px; margin-top:10px; margin-bottom:9px; }
.menu-catalog-title { min-height:36px; font-size:27px; border-top-width:0; border-left-width:5px; border-left-color:#175ccc; padding-top:0; padding-left:9px; margin:0; }
.catalog-filter { width:112px; min-width:112px; margin:0; font-size:19px; color:#203653; }
.catalog-filter .unity-base-field__input { background-color:transparent; border-width:1px; border-color:#aab5c5; border-radius:19px; min-height:38px; padding-left:12px; }
.menu-modal { display:none; position:absolute; left:0; right:0; top:0; bottom:0; align-items:center; justify-content:center; background-color:rgba(19,33,48,.55); }
.menu-modal-panel { width:88%; padding:22px; background-color:#faf8f4; border-radius:16px; border-width:1px; border-color:#d4dbe5; }
.menu-modal-panel .menu-heading { font-size:27px; margin-bottom:12px; }
.menu-modal-panel > Button { margin-top:10px; }
.modal-primary { min-height:56px; font-size:23px; }
.dock .notice { position:absolute; top:-26px; left:0; right:0; height:24px; color:white; -unity-text-outline-width:1px; -unity-text-outline-color:#182536; }
.dock { justify-content:center; }

/* Fantasy B3: ornamental large surfaces; compact actions use dedicated clean gold rims. */
.game-ui { color:#fff4d9; }
.menu-overlay { background-color:#212032; color:#38261d; }
.menu-shell { background-color:transparent; padding:10px; }
.home-body { padding:18px 10px 10px; }
.home-header { padding:0; }
.home-header .menu-title-row { height:88px; min-height:88px; padding:0 14px; margin:0; justify-content:space-between; }
.home-title { font-size:43px; color:#43271e; -unity-text-align:middle-center; min-height:80px; flex-grow:1; }
.home-title-accent, .home-header .menu-subtitle { display:none; }
.settings-button { width:52px; height:52px; border-width:0; border-radius:0; padding:5px; }
.settings-button .menu-icon { width:34px; height:34px; }
.menu-hero { margin:12px 0 12px; border-radius:12px; border-width:4px; border-color:#38241f; }
.home-body .menu-primary { margin:0 7px; height:80px; font-size:32px; }
.home-body .menu-room-row { margin:15px 6px 0; height:60px; }
.menu-room-row > Button { height:60px; min-height:60px; font-size:21px; border-width:0; border-radius:0; }
.menu-room-row .icon-label { color:#472d22; -unity-font-style:bold; font-size:21px; }
.menu-room-row .menu-icon { -unity-background-image-tint-color:#593e2c; }
.menu-status { color:#4e4960; font-size:17px; }
.menu-button, .primary-button, .secondary-button, .waiting-leave, .small-button, .settings-button, .hud-menu-button { border-width:0; border-radius:0; background-color:transparent; }
.menu-button:hover, .primary-button:hover, .secondary-button:hover, .small-button:hover { background-color:transparent; -unity-background-image-tint-color:#fff5cd; }
.menu-button:active, .primary-button:active, .secondary-button:active, .small-button:active { background-color:transparent; -unity-background-image-tint-color:#cbaf81; }
.menu-button:disabled, .primary-button:disabled { background-color:transparent; opacity:.52; }
.menu-button { color:#43271e; -unity-font-style:bold; }
.menu-primary, .primary-button, .info-button, .add-button, .remove-button { color:#fff5db; -unity-text-outline-color:#281b25; -unity-text-outline-width:.75px; }
.menu-tabs { height:90px; padding:5px 5px 7px; border-top-width:0; background-color:transparent; }
.menu-tab { height:78px; margin:0 3px; color:#43271e; border-width:0; }
.menu-tab-selected, .menu-tab-selected:hover { color:#fff4db; background-color:transparent; border-width:0; }
.menu-tab .menu-icon { width:32px; height:32px; -unity-background-image-tint-color:#5b3b27; }
.menu-tab-selected .menu-icon { -unity-background-image-tint-color:#fff4db; }
.menu-tab .icon-label { font-size:22px; }
.deck-body { padding:12px 9px 12px; }
.deck-title-row { height:63px; padding:0 14px; margin:0 0 9px; border-width:0; }
.deck-title-row .menu-title { color:#43271e; font-size:31px; }
.menu-deck-count { background-color:transparent; color:#fff4db; border-radius:0; font-size:21px; padding:9px 13px; -unity-text-align:middle-center; }
.deck-panel { padding:9px 8px; }
.menu-card-row { margin:5px 0; flex-shrink:0; }
.menu-card { background-color:#201b29; border-color:#261a1d; border-width:2px; border-radius:10px; flex-shrink:0; }
.menu-card-art { top:2px; left:2px; right:2px; bottom:2px; }
.menu-card-name { display:flex; left:2px; right:2px; bottom:2px; height:23px; font-size:15px; color:#fff2c9; background-color:rgba(23,21,32,.91); }
.menu-card-cost { background-color:transparent; border-width:0; width:34px; height:34px; top:1px; left:1px; color:#fff; font-size:21px; -unity-text-outline-width:.7px; -unity-text-outline-color:#2f124d; }
.menu-card-selected, .menu-card-selected:hover, .menu-card-selected:focus, .replace-target { border-width:3px; border-color:#ffdb49; }
.empty-slot { background-color:#e4c48f; border-width:2px; border-color:#b48a52; }
.empty-card-label { font-size:36px; color:#956936; -unity-text-align:middle-center; flex-grow:1; }
.deck-guide { color:#6a4832; font-size:16px; }
.deck-footer { margin:8px 2px 2px; }
.menu-reset { color:#54321d; font-size:15px; min-height:37px; padding:4px 9px; }
.catalog-header { height:56px; padding:0 10px; margin:13px 0 5px; border-width:0; }
.menu-catalog-title { font-size:26px; color:#43271e; padding-left:0; border-width:0; }
.catalog-filter { width:105px; min-width:105px; font-size:17px; }
.catalog-filter .unity-base-field__input { color:#4b3024; background-color:#fff0ca; border-color:#b98a4b; border-radius:10px; }
.menu-catalog { padding:6px 8px; }
.menu-details { background-color:transparent; color:#765239; font-size:17px; -unity-text-align:middle-center; }
.menu-modal { background-color:rgba(17,14,26,.70); }
.menu-modal-panel { border-width:0; border-radius:0; background-color:transparent; padding:23px; }
.menu-heading { color:#43271e; }
.menu-field .unity-base-field__label { color:#66462e; }
.menu-field .unity-base-text-field__input { color:#43271e; border-color:#ad7841; background-color:#fff3d8; }
.replace-bar { display:none; flex-direction:row; align-items:center; padding:7px 8px; margin-top:8px; flex-shrink:0; background-color:#ffe1a0; border-width:1px; border-color:#b68042; border-radius:8px; }
.replace-bar .deck-guide { flex-grow:1; flex-shrink:1; white-space:normal; }
.replace-bar Button { min-height:37px; font-size:16px; }
.card-action-layer { display:none; position:absolute; left:0; right:0; top:0; bottom:0; background-color:rgba(18,13,22,.18); }
.card-action-panel { position:absolute; height:76px; flex-direction:row; align-items:center; padding:7px; border-width:0; border-radius:0; }
.card-action-panel > Button { flex-grow:1; flex-basis:0; min-width:0; height:58px; min-height:58px; margin:0 3px; font-size:18px; padding:3px 5px; }
.card-detail-panel { width:94%; max-height:92%; min-height:0; padding:15px 16px 18px; }
.detail-header { flex-direction:row; align-items:center; justify-content:space-between; height:63px; flex-shrink:0; padding:0 8px; margin-bottom:10px; }
.detail-title { font-size:31px; color:#43271e; -unity-font-style:bold; flex-grow:1; -unity-text-align:middle-center; }
.close-button { width:45px; min-width:45px; height:45px; min-height:45px; color:#fff5de; font-size:28px; padding:0; }
.detail-scroll { flex-shrink:1; flex-grow:1; min-height:0; max-height:690px; }
.detail-stage { height:228px; flex-shrink:0; background-size:cover; overflow:hidden; border-width:3px; border-color:#704222; border-radius:10px; }
.detail-sprite { position:absolute; left:0; right:0; top:3px; bottom:3px; }
.detail-cost { position:absolute; left:9px; top:9px; width:50px; height:50px; color:white; font-size:31px; -unity-font-style:bold; -unity-text-align:middle-center; -unity-text-outline-color:#421856; -unity-text-outline-width:.75px; }
.detail-name { color:#43271e; font-size:32px; -unity-font-style:bold; margin-top:7px; -unity-text-align:middle-center; }
.detail-type { color:#84521f; font-size:18px; -unity-text-align:middle-center; }
.detail-description { color:#503321; font-size:19px; white-space:normal; margin:8px 4px; }
.detail-stats { flex-shrink:0; }
.stat-row { flex-direction:row; flex-shrink:0; height:55px; margin:3px 0; }
.stat-cell { flex-grow:1; flex-basis:0; flex-shrink:0; min-width:0; margin:0 3px; padding:5px 9px; justify-content:center; }
.stat-label { color:#765238; font-size:15px; }
.stat-value { color:#37261f; font-size:21px; -unity-font-style:bold; }
.detail-footer { flex-direction:row; height:65px; flex-shrink:0; margin-top:10px; }
.detail-footer Button { flex-grow:1; flex-basis:0; min-width:0; margin:0 4px; min-height:58px; font-size:22px; }
.dock { background-color:transparent; padding:12px 16px; }
.dock-frame { background-color:transparent; }
.top-hud .timer { background-color:transparent; border-width:0; color:#fff4d9; font-size:22px; }
.hud-menu-button { background-color:transparent; }
.hud-menu-panel { background-color:transparent; border-width:0; padding:13px; }
.small { color:#523721; }
.small-button { color:#412c20; }
.danger-button { color:#b12d28; }
.card-cost { background-color:transparent; border-width:0; font-size:23px; }
.unit-card, .drag-card { background-color:#221c29; border-width:2px; border-color:#3a261f; }
.card-art { top:3px; left:3px; right:3px; bottom:3px; }
.unit-card .card-name, .drag-card .card-name { display:flex; color:#fff2c6; background-color:rgba(24,20,30,.91); }
.b3-card-frame { border-width:0; background-color:transparent; background-image:none; }
.next-card-art { border-width:2px; border-color:#dfaa4f; }
.energy-pip { background-color:#332444; border-width:1px; border-color:#7b4e49; }
.energy-pip-fill { background-color:#ce56ef; }
.energy-label { color:#fff3d5; }
.lobby-panel { border-width:0; background-color:transparent; color:#43271e; }
.title,.section-title { color:#43271e; }
.subtitle,.hint { color:#75533b; }
.players { color:#43271e; }
.invite-code { color:#27589b; }

.skin-slice { -unity-slice-left:24; -unity-slice-right:24; -unity-slice-top:24; -unity-slice-bottom:24; -unity-slice-scale:.65px; -unity-background-scale-mode:stretch-to-fill; }
.skin-small-slice { -unity-slice-left:15; -unity-slice-right:15; -unity-slice-top:15; -unity-slice-bottom:15; -unity-slice-scale:.55px; -unity-background-scale-mode:stretch-to-fill; }
.skin-frame-slice { -unity-slice-left:20; -unity-slice-right:20; -unity-slice-top:20; -unity-slice-bottom:20; -unity-slice-scale:.38px; -unity-background-scale-mode:stretch-to-fill; }
.skin-badge { -unity-background-scale-mode:scale-to-fit; }
.menu-card-frame { position:absolute; left:0; right:0; top:0; bottom:0; background-color:transparent; }
.menu-card .menu-card-name { left:4px; right:4px; bottom:4px; }
.menu-card-art { left:3px; right:3px; top:3px; bottom:3px; }
.menu-card-selected .menu-card-frame, .replace-target .menu-card-frame { -unity-background-image-tint-color:#ffde4a; }
.card-detail-panel .detail-stage { background-size:cover; }
.top-hud .timer { color:#43271e; }
.hud-menu-panel .danger-button { color:#fff4db; -unity-text-outline-color:#43201e; -unity-text-outline-width:.7px; }
.waiting-leave { color:#fff4db; -unity-text-outline-color:#43201e; -unity-text-outline-width:.7px; }
