.game-ui { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: #f7efd9; font-size: 20px; }
.world-input, .full-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
Label { white-space: normal; }
Button { color: #f7efd9; border-width: 1px; border-color: #55708a; border-radius: 10px; background-color: #243b54; padding: 10px 16px; -unity-text-align: middle-center; font-size: 20px; }
Button:hover { background-color: #355775; }
Button:active { background-color: #173047; }
Button:disabled { color: #91a1ad; background-color: #24313e; border-color: #3e4c57; }
.top-hud { position: absolute; left: 20px; right: 20px; top: 16px; height: 64px; flex-direction: row; align-items: center; justify-content: space-between; }
.header-copy { flex-grow: 1; }
.brand { font-size: 24px; color: #f1c975; }
.small { font-size: 14px; color: #c5d3de; }
.timer { font-size: 34px; -unity-text-align: middle-center; }
.small-button { width: 84px; height: 48px; font-size: 17px; margin-left: 8px; padding: 4px; }
.dock-frame { position: absolute; bottom: 0; background-color: #132438; border-top-left-radius: 8px; border-top-right-radius: 8px; }
.dock { position: absolute; width: 600px; height: 234px; bottom: 0; padding: 10px 16px; transform-origin: 50% 100%; background-color: #132438; border-top-width: 2px; border-top-color: #53697d; border-top-left-radius: 12px; border-top-right-radius: 12px; }
.energy-row { flex-direction: row; align-items: center; height: 28px; margin-bottom: 6px; }
.energy-label { width: 150px; color: #ebccff; }
.energy-pips { flex-direction: row; flex-grow: 1; height: 17px; }
.energy-pip { flex-grow: 1; margin-right: 4px; border-radius: 3px; background-color: #3c3454; overflow: hidden; }
.energy-pip-fill { width: 0; height: 100%; background-color: #b18aef; }
.energy-full .energy-pip-fill { background-color: #e4b3ff; }
.energy-full .energy-mode { color: #ffe39c; }
.hand-layout { flex-direction: row; align-items: center; justify-content: space-between; height: 150px; flex-shrink: 0; }
.card-row { flex-direction: row; align-items: center; width: 488px; flex-shrink: 0; }
.unit-card { width: 112px; height: 150px; flex-shrink: 0; margin-right: 10px; padding: 0; overflow: hidden; background-color: #183149; border-width: 3px; border-color: #b5c6d5; border-radius: 10px; font-size: 17px; }
.card-art { position: absolute; top: 0; bottom: 0; left: 0; right: 0; -unity-background-scale-mode: scale-and-crop; }
.card-name { position: absolute; left: 0; right: 0; bottom: 0; height: 28px; padding-bottom: 1px; font-size: 19px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgba(7,18,32,0.86); color: #fff3d2; }
.card-cost { position: absolute; top: 3px; left: 3px; width: 29px; height: 31px; border-radius: 16px; border-width: 2px; border-color: #ecc6ff; background-color: #973cc6; color: white; font-size: 23px; -unity-font-style: bold; -unity-text-align: middle-center; }
.next-card { width: 64px; flex-shrink: 0; align-items: center; }
.next-card-art { width: 60px; height: 80px; -unity-background-scale-mode: scale-and-crop; border-radius: 7px; border-width: 2px; border-color: #6f859b; opacity: 0.85; }
.next-card-label { font-size: 13px; color: #b7c9d7; -unity-text-align: middle-center; }
.energy-mode { color: #d9b1ff; font-size: 15px; margin-left: 8px; }
.unit-card.selected { border-color: #f5d17a; background-color: #36688f; }
.unit-card.unaffordable { color: #9caab8; background-color: #253d50; }
.unit-card.unaffordable .card-art { opacity: 0.5; }
.unit-card.dragging { opacity: 0; }
.drag-card { display: none; position: absolute; left: 0; top: 0; width: 112px; height: 150px; transform-origin: 0 0; overflow: hidden; opacity: 0.68; border-width: 3px; border-color: #f5d17a; border-radius: 10px; background-color: #183149; }
.drag-card.invalid { border-color: #f08270; }
.keep-status { position: absolute; top: 8px; left: 0; width: 84px; font-size: 10px; color: #f5d17a; -unity-text-align: middle-center; background-color: rgba(9,19,31,0.8); }
.card-copy { flex-grow: 1; margin-left: 20px; }
.card-title { font-size: 22px; margin-bottom: 5px; }
.hint { color: #b7c9d7; font-size: 17px; margin-top: 6px; }
.notice { height: 22px; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 14px; color: #e8cd8c; margin-top: 6px; }
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(9, 19, 31, 0.87); }
.waiting-overlay { background-color: rgba(9, 19, 31, 0.62); }
.lobby-panel { width: 88%; max-width: 500px; padding: 30px; background-color: #192d43; border-radius: 18px; border-width: 1px; border-color: #63798c; }
.title { font-size: 44px; color: #f5d17a; -unity-text-align: middle-center; }
.eyebrow { font-size: 16px; color: #a5bace; -unity-text-align: middle-center; margin-top: 4px; }
.subtitle { font-size: 20px; color: #d2dce3; -unity-text-align: middle-center; margin-top: 12px; margin-bottom: 20px; }
TextField { margin: 8px 0; font-size: 19px; flex-direction: column; }
.unity-base-field__label { color: #cad8e4; margin-bottom: 6px; }
.unity-base-text-field__input { color: #f7efd9; background-color: #0c1e2e; border-width: 1px; border-color: #49647c; border-radius: 7px; padding: 10px; min-height: 42px; }
.primary-button { min-height: 56px; margin-top: 16px; background-color: #a7752f; border-color: #e4bc72; }
.primary-button:hover { background-color: #c18b3e; }
.secondary-button { min-height: 48px; margin-top: 12px; }
.waiting-actions { flex-direction: row; }
.waiting-actions > Button { flex-grow: 1; flex-basis: 0; }
.waiting-leave { min-height: 56px; margin-top: 16px; margin-left: 12px; }
.divider { height: 1px; background-color: #42576b; margin-top: 24px; margin-bottom: 12px; }
.lobby-status { min-height: 44px; }
.section-title { font-size: 27px; -unity-text-align: middle-center; }
.invite-code { font-size: 44px; color: #f5d17a; margin-top: 12px; -unity-text-align: middle-center; }
.players { font-size: 21px; white-space: normal; margin-top: 24px; margin-bottom: 12px; }
.health-bar { position: absolute; width: 84px; height: 6px; transform-origin: 0 0; background-color: #0d1e2d; border-width: 1px; border-color: #1d3040; border-radius: 2px; }
.health-fill { height: 100%; background-color: #69bcf0; border-radius: 2px; }
.health-bar.enemy .health-fill { background-color: #f08270; }
.health-amount { position: absolute; left: -4px; right: -4px; top: -12px; height: 18px; font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; color: white; -unity-text-outline-color: #0d1e2d; -unity-text-outline-width: 1px; white-space: nowrap; }
.health-bar.unit-health { width: 32px; height: 4px; border-width: 0; }
.unit-health .health-amount { top: -17px; height: 16px; font-size: 13px; }
.unit-status { position: absolute; top: -30px; left: -10px; width: 52px; font-size: 10px; color: #b4edff; -unity-text-align: middle-center; }
